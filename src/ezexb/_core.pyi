from typing import Literal

__version__: str
DEFAULT_MAX_FILE_BYTES: int

class ExbError(Exception): ...
class InputLimitError(ExbError): ...
class InvalidInputError(ExbError): ...
class UnsupportedFeatureError(ExbError): ...
class InvalidContainerError(ExbError): ...
class InvalidStreamError(ExbError): ...
class StreamNotFoundError(ExbError): ...

class IncompleteReadError(ExbError):
    report_json: str
    report: object

_Limits = tuple[int, int, int, int, int, int, int, int, int, int, int, int]

class Container:
    @staticmethod
    def open_file(path: str, limits: _Limits) -> Container: ...
    @staticmethod
    def open_bytes(data: bytes, limits: _Limits) -> Container: ...
    def info_json(self) -> str: ...
    def read_stream(self, path: str, offset: int = 0, length: int | None = None) -> bytes: ...
    def stream_sha256(self, path: str) -> str: ...
    def file_info_json(self) -> str: ...
    def app_info_json(self) -> str: ...
    def preview_info_json(self) -> str: ...
    def preview_bmp(self) -> bytes: ...
    def stream_payload(self, path: str) -> tuple[str, bytes]: ...
    def record_headers_json(self, path: str) -> str: ...
    def lines_json(self, path: str) -> str: ...
    def document_json(self, strict: bool) -> str: ...
    def world_json(self, space_id: int, strict: bool) -> str: ...
    def svg_json(self, space_id: int, strict: bool) -> str: ...
    def close(self) -> None: ...

def inspect_file_json(path: str, limits: _Limits) -> str: ...
def inspect_bytes_json(data: bytes, limits: _Limits) -> str: ...
def probe_bytes(
    data: bytes, max_file_bytes: int
) -> tuple[Literal["cfb", "legacy_caxa_candidate", "unknown"], int]: ...
def probe_file(
    path: str, max_file_bytes: int
) -> tuple[Literal["cfb", "legacy_caxa_candidate", "unknown"], int]: ...
def require_entity_reader() -> None: ...
